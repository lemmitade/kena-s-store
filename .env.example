# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION: PREMIUM ETHIOPIAN E-COMMERCE PLATFORM
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Public Supabase Project URL (Client-safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public Supabase Anon Key (Client-safe with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Privileged Supabase Service Role Key (NEVER EXPOSE IN FRONTEND CODE)
# Used only in server actions, webhooks, and background jobs
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# CHAPA PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Chapa Public Key for client-side redirection or inline widgets
NEXT_PUBLIC_CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxx"

# Chapa Secret Key (Server-only for initiating and verifying transactions)
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxx"

# Chapa Webhook Secret for HMAC SHA256 signature verification
CHAPA_WEBHOOK_SECRET="your_chapa_webhook_secret_key"

# ------------------------------------------------------------------------------
# TELEGRAM NOTIFICATIONS BOT
# ------------------------------------------------------------------------------
# Telegram Bot Token generated from @BotFather (Server-only)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Telegram Destination Chat / Channel ID for merchant alerts (Server-only)
TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# STORE BRANDING & DEFAULTS (CAN ALSO BE CONFIGURED VIA ADMIN SETTINGS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_STORE_NAME="YOUR BRAND"
NEXT_PUBLIC_DEFAULT_CURRENCY="ETB"
GOOGLE_SITE_VERIFICATION="your_google_site_verification_token"
